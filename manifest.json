{
  "schemaVersion": 1,
  "id": "marcho78.yapper",
  "name": "Yapper",
  "version": "1.0.5",
  "author": "marcho78",
  "license": "MIT",
  "description": "End-to-end encrypted chat from the bar or as a window. Matrix (Olm/Megolm) via the omarchy-yapperd daemon; the shell never touches a key.",
  "kinds": [
    "service",
    "bar-widget",
    "panel"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml",
    "panel": "Window.qml"
  },
  "barWidget": {
    "displayName": "Yapper",
    "description": "Encrypted Matrix chat: rooms, unread count and a composer in a bar popup; middle-click or the open button opens the full window. Two looks: the designed Yapper look with palettes, or the Omarchy look on the shell's widgets.",
    "category": "Communication",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "look": "yapper",
      "theme": "omarchy",
      "yapperBackgroundColor": "",
      "yapperSidebarColor": "",
      "yapperTextColor": "",
      "yapperAccent": "",
      "yapperHoverColor": "",
      "yapperSelectionColor": "",
      "customPalettes": [],
      "homeserver": "https://matrix.org",
      "notifications": true,
      "autostartDaemon": true,
      "backgroundColor": "",
      "sidebarColor": "",
      "textColor": "",
      "accentColor": "",
      "messageStyle": "flat",
      "showAvatars": true,
      "senderColors": true,
      "fontScale": 100,
      "hoverColor": "",
      "selectionColor": "",
      "checkUpdates": true,
      "roomSort": "activity",
      "linkPreviews": true,
      "voiceVolume": 100,
      "voiceInput": "",
      "voiceOutput": "",
      "communitySpace": "#omarchy-community:matrix.org",
      "communityPrompt": true,
      "dmPolicy": "anyone"
    },
    "schema": [
      {
        "key": "homeserver",
        "type": "string",
        "label": "Homeserver",
        "defaultValue": "https://matrix.org",
        "description": "Pre-filled on the login form. Any Matrix homeserver works.",
        "section": "Account"
      },
      {
        "key": "notifications",
        "type": "boolean",
        "label": "Notify on new messages",
        "defaultValue": true,
        "section": "Notifications",
        "description": "For rooms no Yapper view is showing."
      },
      {
        "key": "autostartDaemon",
        "type": "boolean",
        "label": "Start the daemon when needed",
        "defaultValue": true,
        "description": "Runs 'systemctl --user start omarchy-yapperd' when it is installed but not running.",
        "section": "Daemon"
      },
      {
        "key": "look",
        "type": "enum",
        "label": "Look",
        "defaultValue": "yapper",
        "options": [
          {
            "value": "yapper",
            "label": "Yapper \u2014 the designed look, with palettes"
          },
          {
            "value": "omarchy",
            "label": "Omarchy \u2014 the shell's widgets, follows the desktop theme"
          }
        ],
        "description": "Which set of screens draws the window and the popup.",
        "section": "Appearance"
      },
      {
        "key": "theme",
        "type": "enum",
        "label": "Palette (Yapper look)",
        "defaultValue": "omarchy",
        "options": [
          {
            "value": "omarchy",
            "label": "Omarchy theme (follows the desktop)"
          },
          {
            "value": "tokyonight",
            "label": "Tokyo Night"
          },
          {
            "value": "catppuccin",
            "label": "Catppuccin"
          },
          {
            "value": "gruvbox",
            "label": "Gruvbox"
          },
          {
            "value": "everforest",
            "label": "Everforest"
          },
          {
            "value": "rosepine",
            "label": "Ros\u00e9 Pine"
          },
          {
            "value": "matte",
            "label": "Matte Black"
          },
          {
            "value": "latte",
            "label": "Catppuccin Latte (light)"
          }
        ],
        "description": "Colors for the Yapper look. The color settings below belong to the Omarchy look.",
        "section": "Appearance"
      },
      {
        "key": "backgroundColor",
        "type": "string",
        "label": "Window background",
        "defaultValue": "",
        "description": "The window and popup surface.",
        "format": "color",
        "section": "Appearance"
      },
      {
        "key": "sidebarColor",
        "type": "string",
        "label": "Sidebar background",
        "defaultValue": "",
        "description": "The room list. Defaults to the window background.",
        "format": "color",
        "section": "Appearance"
      },
      {
        "key": "textColor",
        "type": "string",
        "label": "Text",
        "defaultValue": "",
        "description": "Message and interface text.",
        "format": "color",
        "section": "Appearance"
      },
      {
        "key": "accentColor",
        "type": "string",
        "label": "Accent",
        "defaultValue": "",
        "description": "Links, your name, unread badges, the encrypted glyph.",
        "format": "color",
        "section": "Appearance"
      },
      {
        "key": "hoverColor",
        "type": "string",
        "format": "color",
        "section": "Appearance",
        "label": "Hover highlight",
        "defaultValue": "",
        "description": "Rows and messages under the pointer."
      },
      {
        "key": "selectionColor",
        "type": "string",
        "format": "color",
        "section": "Appearance",
        "label": "Selection",
        "defaultValue": "",
        "description": "The open room in the list."
      },
      {
        "key": "messageStyle",
        "type": "enum",
        "label": "Message style",
        "defaultValue": "flat",
        "options": [
          {
            "value": "flat",
            "label": "Flat (Element / Slack: avatar, name, grouped)"
          },
          {
            "value": "bubbles",
            "label": "Bubbles (yours on the right, theirs on the left)"
          }
        ],
        "section": "Messages"
      },
      {
        "key": "showAvatars",
        "type": "boolean",
        "label": "Show avatars",
        "defaultValue": true,
        "section": "Messages"
      },
      {
        "key": "senderColors",
        "type": "boolean",
        "label": "Color each sender's name",
        "defaultValue": true,
        "description": "Off: names use the text color, yours the accent.",
        "section": "Messages"
      },
      {
        "key": "fontScale",
        "type": "integer",
        "label": "Chat text size (%)",
        "min": 80,
        "max": 150,
        "step": 5,
        "defaultValue": 100,
        "section": "Messages"
      },
      {
        "key": "linkPreviews",
        "type": "boolean",
        "section": "Messages",
        "label": "Link previews",
        "defaultValue": true,
        "description": "Show a card for the first link in a message. Your homeserver fetches the page, not this machine."
      },
      {
        "key": "voiceVolume",
        "type": "integer",
        "section": "Messages",
        "label": "Voice playback volume",
        "defaultValue": 100,
        "min": 20,
        "max": 100,
        "step": 5,
        "description": "Volume for voice messages, relative to the system output. Voice notes are loudness-normalised on the way in and out."
      },
      {
        "key": "roomSort",
        "type": "enum",
        "section": "Rooms",
        "label": "Sort rooms by",
        "defaultValue": "activity",
        "options": [
          {
            "value": "activity",
            "label": "Unread first, then recent activity"
          },
          {
            "value": "name",
            "label": "Name"
          }
        ]
      },
      {
        "key": "checkUpdates",
        "type": "boolean",
        "section": "Updates",
        "label": "Check for updates",
        "defaultValue": true,
        "description": "Once a day, compare the plugin with its git remote and the daemon with its newest release tag. Nothing is installed without you."
      }
    ]
  },
  "keepLoaded": true
}
