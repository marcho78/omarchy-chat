{
  "schemaVersion": 1,
  "id": "marcho78.yapper",
  "name": "Yapper",
  "version": "0.1.0",
  "author": "marcho78",
  "license": "MIT",
  "description": "End-to-end encrypted chat from the bar or as a window. Matrix (Olm/Megolm) via the omarchy-yapperd daemon; the shell never touches a key.",
  "kinds": [
    "service",
    "bar-widget",
    "panel"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml",
    "panel": "Window.qml"
  },
  "barWidget": {
    "displayName": "Yapper",
    "description": "Encrypted Matrix chat: rooms, unread count and a composer in a bar panel; middle-click or the App button opens the full window.",
    "category": "Communication",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "homeserver": "https://matrix.org",
      "notifications": true,
      "autostartDaemon": true,
      "backgroundColor": "",
      "sidebarColor": "",
      "textColor": "",
      "accentColor": "",
      "messageStyle": "flat",
      "showAvatars": true,
      "senderColors": true,
      "fontScale": 100
    },
    "schema": [
      {
        "key": "homeserver",
        "type": "string",
        "label": "Homeserver",
        "defaultValue": "https://matrix.org",
        "description": "Pre-filled on the login form. Any Matrix homeserver works.",
        "section": "Account"
      },
      {
        "key": "notifications",
        "type": "boolean",
        "label": "Notify on new messages",
        "defaultValue": true,
        "section": "Notifications",
        "description": "For rooms no Yapper view is showing."
      },
      {
        "key": "autostartDaemon",
        "type": "boolean",
        "label": "Start the daemon when needed",
        "defaultValue": true,
        "description": "Runs 'systemctl --user start omarchy-yapperd' when it is installed but not running.",
        "section": "Daemon"
      },
      {
        "key": "backgroundColor",
        "type": "string",
        "label": "Window background",
        "defaultValue": "",
        "description": "The window and popup surface.",
        "format": "color",
        "section": "Appearance"
      },
      {
        "key": "sidebarColor",
        "type": "string",
        "label": "Sidebar background",
        "defaultValue": "",
        "description": "The room list. Defaults to the window background.",
        "format": "color",
        "section": "Appearance"
      },
      {
        "key": "textColor",
        "type": "string",
        "label": "Text",
        "defaultValue": "",
        "description": "Message and interface text.",
        "format": "color",
        "section": "Appearance"
      },
      {
        "key": "accentColor",
        "type": "string",
        "label": "Accent",
        "defaultValue": "",
        "description": "Links, your name, unread badges, the encrypted glyph.",
        "format": "color",
        "section": "Appearance"
      },
      {
        "key": "messageStyle",
        "type": "enum",
        "label": "Message style",
        "defaultValue": "flat",
        "options": [
          {
            "value": "flat",
            "label": "Flat (Element / Slack: avatar, name, grouped)"
          },
          {
            "value": "bubbles",
            "label": "Bubbles (yours on the right, theirs on the left)"
          }
        ],
        "section": "Messages"
      },
      {
        "key": "showAvatars",
        "type": "boolean",
        "label": "Show avatars",
        "defaultValue": true,
        "section": "Messages"
      },
      {
        "key": "senderColors",
        "type": "boolean",
        "label": "Colour each sender's name",
        "defaultValue": true,
        "description": "Off: names use the text colour, yours the accent.",
        "section": "Messages"
      },
      {
        "key": "fontScale",
        "type": "integer",
        "label": "Chat text size (%)",
        "min": 80,
        "max": 150,
        "step": 5,
        "defaultValue": 100,
        "section": "Messages"
      }
    ]
  },
  "keepLoaded": true
}
