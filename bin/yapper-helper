#!/usr/bin/python3 -I
"""Yapper's helper for the things QML should not do through a shell.

    yapper-helper status                             which daemon package is installed (JSON)
    yapper-helper toolchain                          which build tools are present (JSON)
    yapper-helper install <bin|source> <repo> <sha>  clone the daemon at <sha>, then makepkg -si

`install` is meant to run inside a terminal: it fetches the daemon repository
into $XDG_CACHE_HOME/omarchy-yapper/omarchy-yapperd, checks out exactly the
commit it was given, then hands over to makepkg in packaging/ (compile from
source) or packaging/bin/ (the prebuilt release binary, checksummed in the
PKGBUILD). makepkg -si installs the package with pacman, which asks for your
password in that terminal. Every other program runs by absolute path with a
deadline and an output budget. Nothing else is downloaded or executed.
"""
import json
import os
import select
import signal
import stat
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "omarchy-yapper")
CHECKOUT = os.path.join(CACHE, "omarchy-yapperd")
BINARY = "/usr/bin/omarchy-yapperd"
PACKAGES = ("omarchy-yapperd-bin", "omarchy-yapperd")

GIT = "/usr/bin/git"
CARGO = "/usr/bin/cargo"
RUSTC = "/usr/bin/rustc"
PACMAN = "/usr/bin/pacman"
MAKEPKG = "/usr/bin/makepkg"
SYSTEMCTL = "/usr/bin/systemctl"

OUTPUT_BUDGET = 64 * 1024        # bytes kept from any one tool's output
LINE_LIMIT = 16 * 1024
SHA_LEN = 40


class Failure(Exception):
    pass


def private_dir(path):
    """Open `path` component by component without following symlinks; create
    missing parts (mode 700) under $HOME; return a descriptor to it."""
    if not path.startswith(HOME + "/"):
        raise Failure("%s is outside your home" % path)
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    parts = [p for p in path.split("/") if p]
    walked = ""
    for part in parts:
        walked += "/" + part
        try:
            nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
        except FileNotFoundError:
            if not walked.startswith(HOME + "/"):
                raise Failure("%s does not exist" % walked)
            os.mkdir(part, 0o700, dir_fd=fd)
            nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
        except OSError as e:
            raise Failure("%s: %s" % (walked, e.strerror))
        os.close(fd)
        fd = nxt
        st = os.fstat(fd)
        if walked.startswith(HOME + "/") and st.st_uid != os.getuid():
            raise Failure("%s is not owned by you" % walked)
    return fd


def run(argv, cwd=None, env=None, deadline=60, on_line=None, log=None):
    """Run argv in its own process group. Lines of output go to `on_line`
    (and the log); only OUTPUT_BUDGET bytes are kept for the error text.
    Past the deadline the whole group is killed."""
    if log:
        log.write("$ %s\n" % " ".join(argv))
        log.flush()
    proc = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, process_group=0, close_fds=True)
    kept = bytearray()
    buf = bytearray()
    end = time.monotonic() + deadline
    fd = proc.stdout.fileno()
    while True:
        left = end - time.monotonic()
        if left <= 0:
            kill_group(proc)
            raise Failure("%s took longer than %d s" % (os.path.basename(argv[0]), deadline))
        ready, _, _ = select.select([fd], [], [], min(left, 1.0))
        if not ready:
            if proc.poll() is not None:
                break
            continue
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        if len(kept) < OUTPUT_BUDGET:
            kept += chunk[:OUTPUT_BUDGET - len(kept)]
        if log:
            log.write(chunk.decode("utf-8", "replace"))
        buf += chunk
        while b"\n" in buf:
            line, _, buf = buf.partition(b"\n")
            if on_line and len(line) <= LINE_LIMIT:
                on_line(line.decode("utf-8", "replace"))
        if len(buf) > LINE_LIMIT:
            buf = bytearray()
    proc.wait()
    return proc.returncode, kept.decode("utf-8", "replace")


def kill_group(proc):
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(proc.pid, sig)
        except ProcessLookupError:
            return
        try:
            proc.wait(timeout=5)
            return
        except subprocess.TimeoutExpired:
            continue


def tail(text, n=12):
    return "\n".join(text.strip().splitlines()[-n:])


def say(text=""):
    print(text, flush=True)


# ---------- commands ----------

def cmd_toolchain():
    have = {"git": os.access(GIT, os.X_OK), "cargo": os.access(CARGO, os.X_OK), "rustc": os.access(RUSTC, os.X_OK)}
    have["ready"] = all(have.values())
    print(json.dumps(have))
    return 0


def cmd_status():
    package, version = "", ""
    for name in PACKAGES:
        code, out = run([PACMAN, "-Q", name], deadline=30)
        if code == 0:
            parts = out.split()
            if len(parts) >= 2:
                package, version = parts[0], parts[1].split("-")[0]
                break
    binary = os.path.isfile(BINARY) and os.access(BINARY, os.X_OK)
    print(json.dumps({"package": package, "version": version, "binary": binary, "checkout": CHECKOUT}))
    return 0


def cmd_install(kind, repo, commit):
    if kind not in ("bin", "source"):
        raise Failure("kind must be bin or source")
    if len(commit) != SHA_LEN or any(c not in "0123456789abcdef" for c in commit):
        raise Failure("the daemon commit must be a full 40-character sha")
    if not repo.startswith("https://"):
        raise Failure("the daemon repository must be an https URL")
    for tool, path in (("git", GIT), ("makepkg", MAKEPKG), ("pacman", PACMAN)):
        if not os.access(path, os.X_OK):
            raise Failure("%s is missing (%s)" % (tool, path))
    env = {"HOME": HOME, "PATH": "/usr/bin", "LANG": "C.UTF-8", "GIT_TERMINAL_PROMPT": "0"}
    for key in ("XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS", "TERM", "DISPLAY", "WAYLAND_DISPLAY"):
        if key in os.environ:
            env[key] = os.environ[key]

    say("Yapper: %s the omarchy-yapperd daemon at %s" % ("installing the prebuilt release of" if kind == "bin" else "building from source", commit[:12]))
    say("        repository %s" % repo)
    say("        checkout   %s" % CHECKOUT)
    say()
    fd = private_dir(CACHE)
    os.close(fd)
    if os.path.isdir(os.path.join(CHECKOUT, ".git")):
        code, out = run([GIT, "-C", CHECKOUT, "fetch", "--quiet", "--tags", "origin"], env=env, deadline=300)
        if code != 0:
            raise Failure("git fetch failed:\n" + tail(out))
    else:
        code, out = run([GIT, "clone", "--quiet", repo, CHECKOUT], env=env, deadline=600)
        if code != 0:
            raise Failure("git clone failed:\n" + tail(out))
    code, out = run([GIT, "-C", CHECKOUT, "checkout", "--quiet", "--force", "--detach", commit], env=env, deadline=120)
    if code != 0:
        raise Failure("that commit is not in the repository:\n" + tail(out))
    # HEAD must be the commit asked for; accept a tag object too, peeled to its commit.
    code, want = run([GIT, "-C", CHECKOUT, "rev-parse", "--verify", commit + "^{commit}"], env=env, deadline=30)
    if code != 0:
        raise Failure("%s is not a commit in the repository" % commit)
    code, head = run([GIT, "-C", CHECKOUT, "rev-parse", "--verify", "HEAD^{commit}"], env=env, deadline=30)
    if code != 0 or head.strip() != want.strip():
        raise Failure("checked-out commit %s does not match %s" % (head.strip()[:12], commit[:12]))
    run([GIT, "-C", CHECKOUT, "clean", "-fdq", "-e", "target", "-e", "src", "-e", "pkg", "-e", "*.tar.gz", "-e", "*.pkg.tar.*"], env=env, deadline=60)

    pkgdir = os.path.join(CHECKOUT, "packaging", "bin" if kind == "bin" else "")
    if not os.path.isfile(os.path.join(pkgdir, "PKGBUILD")):
        raise Failure("no PKGBUILD in %s at this commit" % pkgdir)
    say("Running makepkg -si in %s" % pkgdir)
    say("pacman will ask for your password to install the package%s." % (" and, if missing, rust and git" if kind == "source" else ""))
    if kind == "source":
        say("Compiling matrix-rust-sdk takes 10-25 minutes on a first build.")
    say()
    # makepkg keeps this terminal: it asks, compiles and installs here. -f: rebuild if the same version was built before.
    proc = subprocess.run([MAKEPKG, "-sif", "--needed"], cwd=pkgdir, env=dict(os.environ, PATH="/usr/bin", GIT_TERMINAL_PROMPT="0"))
    if proc.returncode != 0:
        raise Failure("makepkg exited with %d" % proc.returncode)
    say()
    say("Starting the daemon")
    run([SYSTEMCTL, "--user", "daemon-reload"], env=env, deadline=60)
    code, out = run([SYSTEMCTL, "--user", "enable", "omarchy-yapperd.service"], env=env, deadline=60)
    if code != 0:
        raise Failure("could not enable the unit:\n" + tail(out))
    code, out = run([SYSTEMCTL, "--user", "restart", "omarchy-yapperd.service"], env=env, deadline=120)
    if code != 0:
        raise Failure("could not start the daemon:\n" + tail(out))
    say("Done. Yapper will pick the daemon up by itself; you can close this window.")
    return 0


def pause(text):
    say()
    say(text)
    try:
        input("Press Enter to close this window.")
    except (EOFError, KeyboardInterrupt):
        pass


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    cmd, args = argv[0], argv[1:]
    try:
        if cmd == "status":
            return cmd_status()
        if cmd == "toolchain":
            return cmd_toolchain()
        if cmd == "install" and len(args) == 3:
            try:
                code = cmd_install(args[0], args[1], args[2])
            except Failure as e:
                pause("Yapper: the install did not finish: %s" % e)
                return 1
            except KeyboardInterrupt:
                pause("Yapper: the install was interrupted.")
                return 130
            pause("")
            return code
        print(__doc__)
        return 2
    except Failure as e:
        print(json.dumps({"error": str(e)}))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
