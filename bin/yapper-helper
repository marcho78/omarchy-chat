#!/usr/bin/python3 -I
"""Yapper's helper for the things QML should not do through a shell.

    yapper-helper status                             daemon package, unit state (JSON)
    yapper-helper install <bin|source> <repo> <sha>  clone the daemon at <sha>, then makepkg -si
    yapper-helper stop                               stop the daemon and wait for it (JSON)
    yapper-helper start                              start the daemon (JSON)
    yapper-helper reset                              stop, delete the data directory, start again (JSON)
    yapper-helper remove [--data]                    stop, disable, pacman -R the package (terminal)
    yapper-helper plugin-check <dir>                 commits the plugin checkout is behind its remote (JSON)

`install` and `remove` are meant to run inside a terminal. `install` fetches
the daemon repository into $XDG_CACHE_HOME/omarchy-yapper/omarchy-yapperd,
checks out exactly the commit it was given, then runs makepkg -si in
packaging/ (compile from source) or packaging/bin/ (the prebuilt release
binary, checksummed in the PKGBUILD) through a pseudo-terminal: everything
makepkg prints reaches the window unchanged, pacman asks for the password
there, and the helper writes what it sees (phase, crates compiled, timing)
to $XDG_CACHE_HOME/omarchy-yapper/install.json for the panel's progress
card. Every other program runs by absolute path with a deadline and an
output budget. Nothing else is downloaded or executed.
"""
import fcntl
import json
import os
import pty
import re
import select
import shutil
import signal
import stat
import struct
import subprocess
import sys
import termios
import time
import tty

HOME = os.path.expanduser("~")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "omarchy-yapper")
CHECKOUT = os.path.join(CACHE, "omarchy-yapperd")
STATE = os.path.join(CACHE, "install.json")
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), "omarchy-yapperd")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
SOCKET = os.path.join(RUNTIME, "omarchy-yapper.sock")
BINARY = "/usr/bin/omarchy-yapperd"
UNIT = "omarchy-yapperd.service"
PACKAGES = ("omarchy-yapperd-bin", "omarchy-yapperd")

GIT = "/usr/bin/git"
PACMAN = "/usr/bin/pacman"
MAKEPKG = "/usr/bin/makepkg"
SUDO = "/usr/bin/sudo"
SYSTEMCTL = "/usr/bin/systemctl"

OUTPUT_BUDGET = 64 * 1024        # bytes kept from any one tool's output
LINE_LIMIT = 16 * 1024
SHA_LEN = 40


class Failure(Exception):
    pass


def private_dir(path):
    """Open `path` component by component without following symlinks; create
    missing parts (mode 700) under $HOME; return a descriptor to it."""
    if not path.startswith(HOME + "/"):
        raise Failure("%s is outside your home" % path)
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    parts = [p for p in path.split("/") if p]
    walked = ""
    for part in parts:
        walked += "/" + part
        try:
            nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
        except FileNotFoundError:
            if not walked.startswith(HOME + "/"):
                raise Failure("%s does not exist" % walked)
            os.mkdir(part, 0o700, dir_fd=fd)
            nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
        except OSError as e:
            raise Failure("%s: %s" % (walked, e.strerror))
        os.close(fd)
        fd = nxt
        st = os.fstat(fd)
        if walked.startswith(HOME + "/") and st.st_uid != os.getuid():
            raise Failure("%s is not owned by you" % walked)
    return fd


def run(argv, cwd=None, env=None, deadline=60, on_line=None, log=None):
    """Run argv in its own process group. Lines of output go to `on_line`
    (and the log); only OUTPUT_BUDGET bytes are kept for the error text.
    Past the deadline the whole group is killed."""
    if log:
        log.write("$ %s\n" % " ".join(argv))
        log.flush()
    proc = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, process_group=0, close_fds=True)
    kept = bytearray()
    buf = bytearray()
    end = time.monotonic() + deadline
    fd = proc.stdout.fileno()
    while True:
        left = end - time.monotonic()
        if left <= 0:
            kill_group(proc)
            raise Failure("%s took longer than %d s" % (os.path.basename(argv[0]), deadline))
        ready, _, _ = select.select([fd], [], [], min(left, 1.0))
        if not ready:
            if proc.poll() is not None:
                break
            continue
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        if len(kept) < OUTPUT_BUDGET:
            kept += chunk[:OUTPUT_BUDGET - len(kept)]
        if log:
            log.write(chunk.decode("utf-8", "replace"))
        buf += chunk
        while b"\n" in buf:
            line, _, buf = buf.partition(b"\n")
            if on_line and len(line) <= LINE_LIMIT:
                on_line(line.decode("utf-8", "replace"))
        if len(buf) > LINE_LIMIT:
            buf = bytearray()
    proc.wait()
    return proc.returncode, kept.decode("utf-8", "replace")


def kill_group(proc):
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(proc.pid, sig)
        except ProcessLookupError:
            return
        try:
            proc.wait(timeout=5)
            return
        except subprocess.TimeoutExpired:
            continue


def tail(text, n=12):
    return "\n".join(text.strip().splitlines()[-n:])


def say(text=""):
    print(text, flush=True)


def unit_state():
    code, out = run([SYSTEMCTL, "--user", "is-active", UNIT], deadline=30)
    active = out.strip()
    code, out = run([SYSTEMCTL, "--user", "is-enabled", UNIT], deadline=30)
    return active, out.strip()


def wait_unit(wanted, seconds):
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        active, _ = unit_state()
        if (active == "active") == wanted:
            return True
        time.sleep(0.5)
    return False


def installed_package():
    for name in PACKAGES:
        code, out = run([PACMAN, "-Q", name], deadline=30)
        if code == 0:
            parts = out.split()
            if len(parts) >= 2:
                return parts[0], parts[1].split("-")[0]
    return "", ""


# ---------- the install state file ----------

class Progress:
    """What the panel shows while makepkg runs: written atomically on every change."""

    def __init__(self, kind, version):
        self.data = {"kind": kind, "version": version, "phase": "fetch", "done": 0, "total": 0,
                     "started": time.time(), "updated": time.time(), "finished": 0, "ok": False, "error": ""}
        self.write()

    def set(self, phase=None, done=None, total=None):
        if phase is not None and phase != self.data["phase"]:
            self.data["phase"] = phase
            if phase != "build":
                self.data["done"], self.data["total"] = 0, 0
        if done is not None:
            self.data["done"] = done
        if total is not None:
            self.data["total"] = total
        self.write()

    def finish(self, ok, error=""):
        self.data.update(phase="done" if ok else "error", finished=time.time(), ok=ok, error=error)
        self.write()

    def write(self):
        self.data["updated"] = time.time()
        fd = private_dir(CACHE)
        try:
            tmp = ".install.json.%d" % os.getpid()
            tfd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=fd)
            with os.fdopen(tfd, "w") as f:
                json.dump(self.data, f)
            os.rename(tmp, "install.json", src_dir_fd=fd, dst_dir_fd=fd)
        finally:
            os.close(fd)


# What makepkg and cargo print, mapped to phases. Cargo's bar on a tty:
#     Building [=====>          ] 123/456: crate, crate
BUILD_BAR = re.compile(r"Building \[[^\]]*\]\s+(\d+)/(\d+)")
PHASES = (
    ("==> Installing missing dependencies", "deps"),
    ("==> Retrieving sources", "download"),
    ("==> Validating source files", "verify"),
    ("==> Starting prepare()", "prepare"),
    ("==> Starting build()", "build"),
    ("==> Entering fakeroot environment", "package"),
    ("==> Installing package", "install"),
    ("loading packages...", "install"),
)


def run_in_pty(argv, cwd, env, on_text):
    """Run argv on a pseudo-terminal wired to this terminal: keystrokes go
    in (sudo's password prompt works), output comes out unchanged and is
    also handed to on_text. Returns the exit status."""
    pid, master = pty.fork()
    if pid == 0:
        try:
            os.chdir(cwd)
            os.execve(argv[0], argv, env)
        finally:
            os._exit(127)
    stdin = sys.stdin.fileno()
    stdout = sys.stdout.fileno()
    interactive = os.isatty(stdin)

    def resize(*_):
        if not interactive:
            return
        try:
            size = fcntl.ioctl(stdin, termios.TIOCGWINSZ, b"\0" * 8)
            fcntl.ioctl(master, termios.TIOCSWINSZ, size)
        except OSError:
            pass

    saved = None
    if interactive:
        saved = termios.tcgetattr(stdin)
        tty.setraw(stdin)
        signal.signal(signal.SIGWINCH, resize)
        resize()
    try:
        alive = True
        while alive:
            fds = [master] + ([stdin] if interactive else [])
            try:
                ready, _, _ = select.select(fds, [], [], 1.0)
            except InterruptedError:
                continue
            for fd in ready:
                if fd == master:
                    try:
                        chunk = os.read(master, 65536)
                    except OSError:
                        chunk = b""
                    if not chunk:
                        alive = False
                        break
                    os.write(stdout, chunk)
                    on_text(chunk.decode("utf-8", "replace"))
                else:
                    chunk = os.read(stdin, 4096)
                    if chunk:
                        os.write(master, chunk)
    finally:
        if saved is not None:
            termios.tcsetattr(stdin, termios.TCSADRAIN, saved)
            signal.signal(signal.SIGWINCH, signal.SIG_DFL)
        os.close(master)
    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status)


def clear_stale_git_locks():
    """A git run that was killed leaves .git/*.lock behind and every later
    git command refuses to work. Nothing of ours is running now."""
    gitdir = os.path.join(CHECKOUT, ".git")
    for name in ("index.lock", "HEAD.lock", "shallow.lock", "config.lock", "packed-refs.lock"):
        path = os.path.join(gitdir, name)
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            continue
        if stat.S_ISREG(st.st_mode) and time.time() - st.st_mtime > 30:
            os.unlink(path)


# ---------- commands ----------

def cmd_status():
    package, version = installed_package()
    binary = os.path.isfile(BINARY) and os.access(BINARY, os.X_OK)
    active, enabled = unit_state()
    print(json.dumps({"package": package, "version": version, "binary": binary, "active": active == "active",
                      "enabled": enabled == "enabled", "checkout": CHECKOUT, "state": STATE, "data": DATA}))
    return 0


def cmd_stop():
    run([SYSTEMCTL, "--user", "stop", UNIT], deadline=90)
    stopped = wait_unit(False, 30)
    stale = False
    if stopped and os.path.exists(SOCKET):
        # The daemon removes its socket on the way out; a leftover means it was killed.
        stale = True
        try:
            os.unlink(SOCKET)
        except OSError:
            pass
    print(json.dumps({"stopped": stopped, "stale_socket": stale}))
    return 0 if stopped else 1


def cmd_start():
    code, out = run([SYSTEMCTL, "--user", "start", UNIT], deadline=90)
    started = code == 0 and wait_unit(True, 30)
    print(json.dumps({"started": started, "error": "" if started else tail(out, 3)}))
    return 0 if started else 1


def cmd_reset():
    run([SYSTEMCTL, "--user", "stop", UNIT], deadline=90)
    if not wait_unit(False, 30):
        raise Failure("the daemon did not stop")
    shutil.rmtree(DATA, ignore_errors=True)
    try:
        os.unlink(SOCKET)
    except OSError:
        pass
    started = False
    if os.path.isfile(BINARY):
        code, out = run([SYSTEMCTL, "--user", "start", UNIT], deadline=90)
        started = code == 0 and wait_unit(True, 30)
    print(json.dumps({"reset": True, "started": started}))
    return 0


def cmd_install(kind, repo, commit):
    if kind not in ("bin", "source"):
        raise Failure("kind must be bin or source")
    if len(commit) != SHA_LEN or any(c not in "0123456789abcdef" for c in commit):
        raise Failure("the daemon commit must be a full 40-character sha")
    if not repo.startswith("https://"):
        raise Failure("the daemon repository must be an https URL")
    for tool, path in (("git", GIT), ("makepkg", MAKEPKG), ("pacman", PACMAN)):
        if not os.access(path, os.X_OK):
            raise Failure("%s is missing (%s)" % (tool, path))
    env = {"HOME": HOME, "PATH": "/usr/bin", "LANG": "C.UTF-8", "GIT_TERMINAL_PROMPT": "0"}
    for key in ("XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS", "TERM", "DISPLAY", "WAYLAND_DISPLAY", "COLORTERM"):
        if key in os.environ:
            env[key] = os.environ[key]

    say("Yapper: %s omarchy-yapperd at %s" % ("installing the prebuilt release of" if kind == "bin" else "building from source", commit[:12]))
    say("        repository %s" % repo)
    say("        checkout   %s" % CHECKOUT)
    say()
    fd = private_dir(CACHE)
    os.close(fd)
    progress = Progress(kind, "")
    try:
        clear_stale_git_locks()
        if os.path.isdir(os.path.join(CHECKOUT, ".git")):
            code, out = run([GIT, "-C", CHECKOUT, "fetch", "--quiet", "--tags", "origin"], env=env, deadline=300)
            if code != 0:
                raise Failure("git fetch failed:\n" + tail(out))
        else:
            code, out = run([GIT, "clone", "--quiet", repo, CHECKOUT], env=env, deadline=600)
            if code != 0:
                raise Failure("git clone failed:\n" + tail(out))
        code, out = run([GIT, "-C", CHECKOUT, "checkout", "--quiet", "--force", "--detach", commit], env=env, deadline=120)
        if code != 0:
            raise Failure("that commit is not in the repository:\n" + tail(out))
        # HEAD must be the commit asked for; accept a tag object too, peeled to its commit.
        code, want = run([GIT, "-C", CHECKOUT, "rev-parse", "--verify", commit + "^{commit}"], env=env, deadline=30)
        if code != 0:
            raise Failure("%s is not a commit in the repository" % commit)
        code, head = run([GIT, "-C", CHECKOUT, "rev-parse", "--verify", "HEAD^{commit}"], env=env, deadline=30)
        if code != 0 or head.strip() != want.strip():
            raise Failure("checked-out commit %s does not match %s" % (head.strip()[:12], commit[:12]))
        run([GIT, "-C", CHECKOUT, "clean", "-fdq", "-e", "target", "-e", "src", "-e", "pkg", "-e", "*.tar.gz", "-e", "*.pkg.tar.*"], env=env, deadline=60)

        pkgdir = os.path.join(CHECKOUT, "packaging", "bin" if kind == "bin" else "")
        pkgbuild = os.path.join(pkgdir, "PKGBUILD")
        if not os.path.isfile(pkgbuild):
            raise Failure("no PKGBUILD in %s at this commit" % pkgdir)
        version = ""
        with open(pkgbuild) as f:
            for line in f:
                if line.startswith("pkgver="):
                    version = line[len("pkgver="):].strip()
        progress.data["version"] = version
        progress.set("deps" if kind == "source" else "download")

        say("Running makepkg -si in %s" % pkgdir)
        say("pacman will ask for your password to install the package%s." % (" and, if missing, rust and git" if kind == "source" else ""))
        if kind == "source":
            say("Compiling matrix-rust-sdk takes 10-25 minutes on a first build.")
        say()

        # Before pacman swaps the binary, stop the daemon so the file is not in use.
        active, _ = unit_state()
        if active == "active":
            run([SYSTEMCTL, "--user", "stop", UNIT], deadline=90)
            wait_unit(False, 30)

        pending = [""]

        def on_text(text):
            # Lines end in \n; cargo redraws its bar with \r.
            pending[0] += text
            parts = re.split(r"[\r\n]", pending[0])
            pending[0] = parts.pop()[-LINE_LIMIT:]
            for line in parts:
                for marker, phase in PHASES:
                    if marker in line:
                        progress.set(phase)
                m = BUILD_BAR.search(line)
                if m:
                    progress.set("build", int(m.group(1)), int(m.group(2)))

        # -f: rebuild if this version was built before; --needed: no reinstall of an identical package.
        code = run_in_pty([MAKEPKG, "-sif", "--needed"], pkgdir, dict(env, PATH="/usr/bin:/usr/bin/core_perl"), on_text)
        say()
        if code != 0:
            raise Failure("makepkg exited with %d" % code)
        progress.set("start")
        say("Starting the daemon")
        run([SYSTEMCTL, "--user", "daemon-reload"], env=env, deadline=60)
        code, out = run([SYSTEMCTL, "--user", "enable", UNIT], env=env, deadline=60)
        if code != 0:
            raise Failure("could not enable the unit:\n" + tail(out))
        code, out = run([SYSTEMCTL, "--user", "restart", UNIT], env=env, deadline=120)
        if code != 0:
            raise Failure("could not start the daemon:\n" + tail(out))
        progress.finish(True)
        say("Done in %s. Yapper picks the daemon up by itself; you can close this window." % clock(time.time() - progress.data["started"]))
        return 0
    except BaseException as e:
        progress.finish(False, "interrupted" if isinstance(e, KeyboardInterrupt) else str(e))
        raise


def cmd_remove(with_data):
    package, version = installed_package()
    say("Yapper: removing the daemon%s" % (" and its data" if with_data else ""))
    say()
    run([SYSTEMCTL, "--user", "disable", "--now", UNIT], deadline=90)
    wait_unit(False, 30)
    try:
        os.unlink(SOCKET)
    except OSError:
        pass
    if package:
        say("pacman will ask for your password to remove %s %s." % (package, version))
        proc = subprocess.run([SUDO, PACMAN, "-R", package], env={"PATH": "/usr/bin", "HOME": HOME, "LANG": "C.UTF-8", "TERM": os.environ.get("TERM", "xterm")})
        if proc.returncode != 0:
            raise Failure("pacman exited with %d" % proc.returncode)
    else:
        say("No omarchy-yapperd package is installed.")
    if with_data:
        shutil.rmtree(DATA, ignore_errors=True)
        shutil.rmtree(CACHE, ignore_errors=True)
        say("Removed %s and %s." % (DATA, CACHE))
    else:
        say("Kept your data in %s (Settings > Daemon > Reset the data removes it)." % DATA)
    say("Done.")
    return 0


def cmd_plugin_check(plugin_dir):
    """How far the installed plugin is behind its git remote. A directory that
    is not a clone reports nothing. A clone whose files already carry the
    remote's manifest version reports nothing either: the files are what
    runs, git position is only how they usually get there."""
    if not os.path.isdir(os.path.join(plugin_dir, ".git")):
        print(json.dumps({"behind": 0, "log": [], "checked": False}))
        return 0
    env = {"HOME": HOME, "PATH": "/usr/bin", "LANG": "C.UTF-8", "GIT_TERMINAL_PROMPT": "0", "GIT_SSH_COMMAND": "/usr/bin/ssh -oBatchMode=yes"}
    code, out = run([GIT, "-C", plugin_dir, "fetch", "--quiet", "origin", "HEAD"], env=env, deadline=60)
    if code != 0:
        print(json.dumps({"behind": 0, "log": [], "checked": False, "error": "Could not reach the plugin's git remote."}))
        return 0
    code, out = run([GIT, "-C", plugin_dir, "rev-list", "--count", "HEAD..FETCH_HEAD"], env=env, deadline=30)
    behind = int(out.strip() or "0") if code == 0 else 0
    local_version = remote_version = None
    try:
        with open(os.path.join(plugin_dir, "manifest.json")) as f:
            local_version = json.load(f).get("version")
    except (OSError, ValueError):
        pass
    code, out = run([GIT, "-C", plugin_dir, "show", "FETCH_HEAD:manifest.json"], env=env, deadline=30)
    if code == 0:
        try:
            remote_version = json.loads(out).get("version")
        except ValueError:
            pass
    if behind and local_version and local_version == remote_version:
        behind = 0
    log = []
    if behind:
        code, out = run([GIT, "-C", plugin_dir, "log", "--format=%s", "HEAD..FETCH_HEAD"], env=env, deadline=30)
        log = [l for l in out.splitlines() if l.strip()][:8]
    print(json.dumps({"behind": behind, "log": log, "checked": True, "version": local_version, "remote": remote_version}))
    return 0


def clock(seconds):
    seconds = int(seconds)
    if seconds >= 3600:
        return "%dh %02dm %02ds" % (seconds // 3600, seconds % 3600 // 60, seconds % 60)
    return "%dm %02ds" % (seconds // 60, seconds % 60)


def pause(text):
    say()
    if text:
        say(text)
    try:
        input("Press Enter to close this window.")
    except (EOFError, KeyboardInterrupt):
        pass


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    cmd, args = argv[0], argv[1:]
    if cmd in ("install", "remove"):
        # Terminal commands: report in words and wait so the window stays readable.
        try:
            if cmd == "install" and len(args) == 3:
                code = cmd_install(args[0], args[1], args[2])
            elif cmd == "remove":
                code = cmd_remove("--data" in args)
            else:
                print(__doc__)
                return 2
        except Failure as e:
            pause("Yapper: this did not finish: %s" % e)
            return 1
        except KeyboardInterrupt:
            pause("Yapper: interrupted.")
            return 130
        pause("")
        return code
    try:
        if cmd == "status":
            return cmd_status()
        if cmd == "stop":
            return cmd_stop()
        if cmd == "start":
            return cmd_start()
        if cmd == "reset":
            return cmd_reset()
        if cmd == "plugin-check" and len(args) == 1:
            return cmd_plugin_check(args[0])
        print(__doc__)
        return 2
    except Failure as e:
        print(json.dumps({"error": str(e)}))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
